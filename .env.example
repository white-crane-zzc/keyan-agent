# 复制为 .env 后填写；本文件不含任何真实密钥
# —— 云端 OpenAI 兼容接口（豆包/DeepSeek/通义/Kimi 等均可）——
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=gpt-4o-mini

# —— 或本地 Ollama（装好后 `ollama pull qwen2.5:7b`）——
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 检索与去重参数（可不动）
TOP_K=8
DEDUPE_THRESHOLD=0.90
CHUNK_MAX_CHARS=900
